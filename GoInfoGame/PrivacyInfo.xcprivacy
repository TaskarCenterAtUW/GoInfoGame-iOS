<plist version="1.0">
    <dict>
        <!-- APIs accessed by RealmSwift -->
        <key>NSPrivacyAccessedAPITypes</key>
        <array>
            <dict>
                <key>NSPrivacyAccessedAPIType</key>
                <string>FileTimestamp</string>
            </dict>
            <dict>
                <key>NSPrivacyAccessedAPIType</key>
                <string>FileProviderMetadata</string>
            </dict>
        </array>

        <!-- Data collected by RealmSwift -->
        <key>NSPrivacyCollectedDataTypes</key>
        <array>
            <dict>
                <key>NSPrivacyCollectedDataType</key>
                <string>AppFunctionality</string>
                <key>NSPrivacyCollectedDataTypeReason</key>
                <string>Analytics</string>
            </dict>
        </array>
    </dict>
</plist>



