//
//  Secrets.xcconfig.example
//  GoInfoGame
//
//  Copy this file to Secrets.xcconfig (gitignored) and fill in real values.
//  Secrets.xcconfig is included by Config.xcconfig and must never be committed.
//

KARTAVIEW_ACCESS_TOKEN = your_kartaview_access_token_here
// Panoramax JWT token, created and claimed with scripts/panoramax_demo.sh token
PANORAMAX_TOKEN = your_panoramax_token_here
// Optional Panoramax server override, e.g. a local test server. Leave empty for the
// environment default. Write // as /$()/ because // starts an xcconfig comment:
// PANORAMAX_BASE_URL = http:/$()/Your-Mac.local:5001
PANORAMAX_BASE_URL =
// Where photos are uploaded: kartaview (default) or panoramax
PHOTO_UPLOAD_PROVIDER = kartaview
JAWG_ACCESS_TOKEN = your_jawg_access_token_here
