//
//  Secrets.xcconfig.example
//  GoInfoGame
//
//  Copy this file to Secrets.xcconfig (gitignored) and fill in real values.
//  Secrets.xcconfig is included by Config.xcconfig and must never be committed.
//

// Panoramax, one instance per app environment (Development, Staging, Production).
// Write // as /$()/ because // starts an xcconfig comment.
// A missing base URL falls back to the dev instance built into APIEnvironment.
PANORAMAX_BASE_URL_DEV = https:/$()/your-dev-panoramax.example.com
PANORAMAX_BASE_URL_STAGE = https:/$()/your-stage-panoramax.example.com
PANORAMAX_BASE_URL_PROD = https:/$()/your-prod-panoramax.example.com
// Upload tokens (JWT) for each instance, created and claimed with scripts/panoramax_demo.sh token
PANORAMAX_TOKEN_DEV = your_dev_panoramax_token_here
PANORAMAX_TOKEN_STAGE = your_stage_panoramax_token_here
PANORAMAX_TOKEN_PROD = your_prod_panoramax_token_here
JAWG_ACCESS_TOKEN = your_jawg_access_token_here
